# Google Gemini API Anahtarınız (Ücretsiz almak için: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Varsayılan Yarışma Dili (tr = Türkçe, en = İngilizce)
QUIZ_DEFAULT_LANG=tr

# Her Yarışmadaki Soru Sayısı
QUIZ_QUESTION_COUNT=20

# Her Soru İçin Varsayılan Süre (saniye)
QUIZ_DEFAULT_TIME_LIMIT=20
